# OpenPDFSpecs — LOCAL-ONLY environment (REVAMP Phase B)
# Copy to `.env` for a local-first install. No Supabase, no cloud accounts.
#
#   cp .env.local.example .env
#   .venv/bin/python -m src.cli init
#   .venv/bin/python -m src.cli set-key nvapi-...
#
# (The hosted/multi-tenant template is `.env.example`.)

# --- Local mode ----------------------------------------------------------
# Single implicit org, no login. The admin API skips JWT verification entirely,
# so the server MUST stay bound to loopback (the default below).
PDFSPECS_LOCAL_MODE=1

# --- Postgres ------------------------------------------------------------
# A dedicated database on your local cluster. Requires the pgvector extension:
#   createdb pdfspecs
#   psql -d pdfspecs -c 'create extension if not exists vector;'
DATABASE_URL=postgresql:///pdfspecs

# --- Storage -------------------------------------------------------------
# `local` keeps uploaded PDFs on disk instead of Supabase Storage.
PDFSPECS_STORAGE_BACKEND=local
PDFSPECS_DATA_DIR=~/.pdfspecs/data

# --- App secrets ---------------------------------------------------------
# Encrypts the NVIDIA key at rest. If unset, a key file is generated at
# ~/.pdfspecs/secret.key — fine locally. Set it explicitly to keep the encrypted
# value readable across machines.
# PDFSPECS_FERNET_KEY=<fernet-key>

# --- Embeddings ----------------------------------------------------------
# Must match the chunk_embeddings.embedding vector(N) column. Both backends are 1024-d,
# so switching between them needs no migration.
PDFSPECS_EMBEDDING_DIM=1024

# `local`  = BAAI/bge-m3 via sentence-transformers. Offline, no API quota.
# `nvidia` = PDFSPECS_NVIDIA_EMBEDDING_MODEL over the NIM API. Far faster here (it batches
#            32 windows per request), at the cost of API quota.
PDFSPECS_EMBEDDING_BACKEND=local

# IMPORTANT on an Intel Mac: "MPS" is the weak integrated GPU, not Apple Silicon, and is
# SLOWER than the CPU here — measured 8.3 chunks/min on MPS vs 19.8 on CPU. Torch picks
# MPS automatically, so pin it to cpu. Remove this line on Apple Silicon or a CUDA box.
PDFSPECS_EMBED_DEVICE=cpu
PDFSPECS_EMBED_BATCH_SIZE=16
# BGE-M3 defaults to 8192; our windows are ~900 chars, and the headroom OOMs the GPU.
PDFSPECS_EMBED_MAX_SEQ_LEN=512

# --- Networking ----------------------------------------------------------
# Loopback only: local mode bypasses authentication on the admin API, so the server
# refuses local-mode admin requests from any non-loopback peer. Set
# PDFSPECS_ALLOW_REMOTE_LOCAL_MODE=1 only if you really intend to serve unauthenticated
# admin access (and a remote database) to other machines.
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Provider models -----------------------------------------------------
# Override these when NVIDIA retires a hosted model: a retired id answers 410 Gone, which
# is a client error, so it is never retried and every ingestion fails. List current ids
# with: curl -H "Authorization: Bearer $NVIDIA_API_KEY" \
#            https://integrate.api.nvidia.com/v1/models
PDFSPECS_NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
PDFSPECS_NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Matryoshka width to request. MUST equal PDFSPECS_EMBEDDING_DIM and the vector(N) column.
# Leave empty for a model that does not support reduced widths.
PDFSPECS_NVIDIA_EMBED_DIMENSIONS=1024

# --- Ingestion tuning ----------------------------------------------------
# Seconds between provider API calls (free-tier rate limiting). 0 disables.
PDFSPECS_API_MIN_INTERVAL=1.5
PDFSPECS_ENRICH_CONCURRENCY=1
# Attempts before a failing ingestion task is given up on.
PDFSPECS_MAX_TASK_ATTEMPTS=3
# Minutes a task may go without a progress update before another worker may reclaim it.
# Only relevant when more than one worker runs against the same database; every progress
# tick renews the lease, so a slow-but-alive task is never reclaimed mid-document.
PDFSPECS_TASK_LEASE_MINUTES=15

# --- Frontend (only if you run the local dashboard) -----------------------
# NEXT_PUBLIC_LOCAL_MODE=1
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
