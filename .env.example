# OpenPDFSpecs — environment template (multi-tenant / hosted)
# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Postgres (Supabase) -------------------------------------------------
# Supabase → Project Settings → Database → Connection string (use the pooled
# "Transaction" connection for the backend). Includes password.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# --- Supabase project (new API-key model) --------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) — backend only, full admin/storage access. KEEP SECRET.
SUPABASE_SECRET_KEY=sb_secret_<...>
# JWKS endpoint — backend verifies logged-in users' JWTs (asymmetric).
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=pdf-uploads            # created in M4

# --- App secrets ---------------------------------------------------------
# Fernet key used to encrypt each org's provider API key at rest.
# Generate with:  .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PDFSPECS_FERNET_KEY=<fernet-key>

# --- Embedding model (fixed platform-wide; do not vary per org) ----------
# pgvector column is vector(768) — must match this model's dimension.
PDFSPECS_EMBEDDING_MODEL=text-embedding-004

# --- CORS / networking ---------------------------------------------------
# Comma-separated allowed origins for the API (your deployed frontend).
# Local dev default shown; set to the Vercel URL in production (M7).
CORS_ORIGINS=http://localhost:3000
# Backend bind (public in production so the host can route to it).
HOST=0.0.0.0
PORT=8000

# --- Frontend (Next.js / Vercel) — these are NEXT_PUBLIC_ (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) — public client key, safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000